<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BopItAccess.Installer</AssemblyName>
    <RootNamespace>BopItAccess.Installer</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="uninstall.ps1" LogicalName="BopItAccess.Installer.uninstall.ps1" WithCulture="false" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="BopItAccess.Installer.LICENSE" WithCulture="false" />
    <!-- Keep the official redistribution notices with the self-contained EXE. -->
    <EmbeddedResource Include="third-party\dotnet\LICENSE.txt" LogicalName="BopItAccess.Installer.NET.LICENSE" WithCulture="false" />
    <EmbeddedResource Include="third-party\dotnet\THIRD-PARTY-NOTICES.txt" LogicalName="BopItAccess.Installer.NET.THIRD-PARTY-NOTICES" WithCulture="false" />
    <EmbeddedResource Include="third-party\windowsdesktop\LICENSE.txt" LogicalName="BopItAccess.Installer.WindowsDesktop.LICENSE" WithCulture="false" />
    <EmbeddedResource Include="third-party\NOTICE.txt" LogicalName="BopItAccess.Installer.Runtime.NOTICE" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="BuildReferenceGenerator\**\*.cs" />
    <!-- .cs is also the Czech culture code. These templates are source data,
         so keep them in the main assembly on every build host and UI language. -->
    <EmbeddedResource Include="BuildReferenceGenerator\Program.cs.txt" LogicalName="BopItAccess.Installer.BuildReferenceGenerator.Program.cs.txt" WithCulture="false" />
    <EmbeddedResource Include="BuildReferenceGenerator\BuildReferenceGenerator.csproj.txt" LogicalName="BopItAccess.Installer.BuildReferenceGenerator.BuildReferenceGenerator.csproj.txt" WithCulture="false" />
  </ItemGroup>
  <Target Name="ValidateRequiredInstallerResources" AfterTargets="SplitResourcesByCulture">
    <ItemGroup>
      <_RequiredInstallerResource Include="@(EmbeddedResource)"
          Condition="'%(EmbeddedResource.Identity)' == 'uninstall.ps1' or '%(EmbeddedResource.Identity)' == '..\LICENSE' or '%(EmbeddedResource.Identity)' == 'third-party\dotnet\LICENSE.txt' or '%(EmbeddedResource.Identity)' == 'third-party\dotnet\THIRD-PARTY-NOTICES.txt' or '%(EmbeddedResource.Identity)' == 'third-party\windowsdesktop\LICENSE.txt' or '%(EmbeddedResource.Identity)' == 'third-party\NOTICE.txt' or '%(EmbeddedResource.Identity)' == 'BuildReferenceGenerator\Program.cs.txt' or '%(EmbeddedResource.Identity)' == 'BuildReferenceGenerator\BuildReferenceGenerator.csproj.txt'" />
      <_MisplacedInstallerResource Include="@(_RequiredInstallerResource)"
          Condition="'%(_RequiredInstallerResource.WithCulture)' != 'false' or '%(_RequiredInstallerResource.Culture)' != ''" />
    </ItemGroup>
    <Error Condition="'@(_RequiredInstallerResource->Count())' != '8'"
        Text="The installer must embed its uninstall script, both offline build templates, project licence and Microsoft runtime redistribution notices." />
    <Error Condition="'@(_MisplacedInstallerResource)' != ''"
        Text="Required installer resources must remain culture-neutral in the main assembly: @(_MisplacedInstallerResource). Set WithCulture=false." />
    <Error Condition="'%(_RequiredInstallerResource.Identity)' == 'uninstall.ps1' and '%(_RequiredInstallerResource.LogicalName)' != 'BopItAccess.Installer.uninstall.ps1'"
        Text="The uninstall script has an unexpected embedded resource name." />
    <Error Condition="'%(_RequiredInstallerResource.Identity)' == '..\LICENSE' and '%(_RequiredInstallerResource.LogicalName)' != 'BopItAccess.Installer.LICENSE'"
        Text="The project licence has an unexpected embedded resource name." />
    <Error Condition="'%(_RequiredInstallerResource.Identity)' == 'third-party\dotnet\LICENSE.txt' and '%(_RequiredInstallerResource.LogicalName)' != 'BopItAccess.Installer.NET.LICENSE'"
        Text="The .NET runtime licence has an unexpected embedded resource name." />
    <Error Condition="'%(_RequiredInstallerResource.Identity)' == 'third-party\dotnet\THIRD-PARTY-NOTICES.txt' and '%(_RequiredInstallerResource.LogicalName)' != 'BopItAccess.Installer.NET.THIRD-PARTY-NOTICES'"
        Text="The .NET runtime notices have an unexpected embedded resource name." />
    <Error Condition="'%(_RequiredInstallerResource.Identity)' == 'third-party\windowsdesktop\LICENSE.txt' and '%(_RequiredInstallerResource.LogicalName)' != 'BopItAccess.Installer.WindowsDesktop.LICENSE'"
        Text="The Windows Desktop runtime licence has an unexpected embedded resource name." />
    <Error Condition="'%(_RequiredInstallerResource.Identity)' == 'third-party\NOTICE.txt' and '%(_RequiredInstallerResource.LogicalName)' != 'BopItAccess.Installer.Runtime.NOTICE'"
        Text="The runtime notice provenance has an unexpected embedded resource name." />
    <Error Condition="'%(_RequiredInstallerResource.Identity)' == 'BuildReferenceGenerator\Program.cs.txt' and '%(_RequiredInstallerResource.LogicalName)' != 'BopItAccess.Installer.BuildReferenceGenerator.Program.cs.txt'"
        Text="The offline helper source has an unexpected embedded resource name." />
    <Error Condition="'%(_RequiredInstallerResource.Identity)' == 'BuildReferenceGenerator\BuildReferenceGenerator.csproj.txt' and '%(_RequiredInstallerResource.LogicalName)' != 'BopItAccess.Installer.BuildReferenceGenerator.BuildReferenceGenerator.csproj.txt'"
        Text="The offline helper project has an unexpected embedded resource name." />
  </Target>
</Project>
