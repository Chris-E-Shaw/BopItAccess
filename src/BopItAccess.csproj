<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BopItAccess</AssemblyName>
    <RootNamespace>BopItAccess</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the guide with every local build; the game reads this HTML from
         its documentation folder and does not require a rebuilt DLL when the
         guide text changes. -->
    <None Include="..\BopItAccess-user-guide.html" Link="documentation\BopItAccess-user-guide.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BopItAccess-build-history.html" Link="documentation\BopItAccess-build-history.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.md" Link="documentation\README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.txt" Link="documentation\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\GIT-WORKFLOW.md" Link="documentation\GIT-WORKFLOW.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.txt" Link="documentation\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\documentation\**\*" Link="documentation\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="locales\*.json" LogicalName="BopItAccess.locales.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(BopItGameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BopItGameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BopItGameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppFMODUnity">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\Il2CppFMODUnity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppDOTween">
      <HintPath>$(BopItGameDir)\MelonLoader\Il2CppAssemblies\Il2CppDOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateBopItGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(BopItGameDir)' == ''"
           Text="Set BopItGameDir to your Bop It! installation directory. See the build instructions in README.md." />
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')"
           Text="Required game reference not found: %(Reference.HintPath). Install MelonLoader, launch the game once, and check BopItGameDir." />
  </Target>
</Project>
